    <shape type="text" topLeftX="500" topLeftY="190" width="385" height="215">
      <content textType="body" fontSize="11" color="rgba(226,232,240,1)" fontFamily="Consolas" lineSpacing="multiple:1.5">
        <p>import cinrad, datetime</p>
        <p>f = cinrad.io.read_auto("...CAP_FMT.bin.bz2")</p>
        <p>f.scantime += datetime.timedelta(hours=8)  # 转北京时</p>
        <p>r_list = list(f.iter_tilt(150, "REF"))</p>
        <p>cr = cinrad.calc.quick_cr(r_list)</p>
        <p>from cinrad.visualize import PPI</p>
        <p>PPI(cr, style="black", add_city_names=True)("cr.png")</p>
      </content>
    </shape>

