    <shape type="text" topLeftX="500" topLeftY="190" width="385" height="215">
      <content textType="body" fontSize="11" color="rgba(226,232,240,1)" fontFamily="Consolas" lineSpacing="multiple:1.5">
        <p>from pycwr.io import read_auto</p>
        <p>radar = read_auto("...Z9731_..._CAP_FMT.BIN.bz2")</p>
        <p>qc = apply_dualpol_qc(radar, inplace=False,</p>
        <p>                     clear_air_mode="mask", band='S')</p>
        <p>hcl = qc.classify_hydrometeors(band="S", ...)</p>
        <p>vwp = radar.retrieve_vwp(sweeps=[0,1,2])</p>
        <p>plot_ppi_map(radar, field="dBZ", sweep=0, show=True)</p>
      </content>
    </shape>

    <shape type="text" topLeftX="60" topLeftY="430" width="840" height="80">
